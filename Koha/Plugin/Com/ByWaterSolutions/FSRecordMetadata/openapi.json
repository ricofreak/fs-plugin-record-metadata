{
    "/entries": {
        "get": {
            "x-mojo-to": "Com::ByWaterSolutions::FSRecordMetadata::Controller#list_entries",
            "operationId": "fsrmListEntries",
            "tags": ["fsrecordmetadata"],
            "produces": ["application/json"],
            "parameters": [
                {
                    "name": "biblionumber",
                    "in": "query",
                    "description": "Filter by TN (biblionumber)",
                    "required": false,
                    "type": "integer"
                },
                {
                    "name": "barcode",
                    "in": "query",
                    "description": "Filter by barcode",
                    "required": false,
                    "type": "string"
                },
                {
                    "name": "_page",
                    "in": "query",
                    "description": "Page number",
                    "required": false,
                    "type": "integer"
                },
                {
                    "name": "_per_page",
                    "in": "query",
                    "description": "Results per page",
                    "required": false,
                    "type": "integer"
                }
            ],
            "responses": {
                "200": {
                    "description": "A list of entries",
                    "schema": {
                        "type": "array",
                        "items": { "type": "object" }
                    }
                },
                "400": {
                    "description": "Missing search parameter",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "error": { "type": "string" }
                        }
                    }
                },
                "500": {
                    "description": "Internal server error",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "error": { "type": "string" }
                        }
                    }
                }
            },
            "x-koha-authorization": {
                "permissions": { "catalogue": "1" }
            }
        },
        "post": {
            "x-mojo-to": "Com::ByWaterSolutions::FSRecordMetadata::Controller#create_entry",
            "operationId": "fsrmCreateEntry",
            "tags": ["fsrecordmetadata"],
            "consumes": ["application/json"],
            "produces": ["application/json"],
            "parameters": [
                {
                    "name": "body",
                    "in": "body",
                    "description": "The entry to create",
                    "required": true,
                    "schema": {
                        "type": "object",
                        "properties": {},
                        "required": ["biblionumber"],
                        "additionalProperties": false
                    }
                }
            ],
            "responses": {
                "201": {
                    "description": "Entry created",
                    "schema": { "type": "object" }
                },
                "400": {
                    "description": "Bad request",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "error": { "type": "string" }
                        }
                    }
                },
                "404": {
                    "description": "Biblio not found",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "error": { "type": "string" }
                        }
                    }
                },
                "500": {
                    "description": "Internal server error",
                    "schema": {
                        "type": "object",
                        "properties": {
                            "error": { "type": "string" }
                        }
                    }
                }
            },
            "x-koha-authorization": {
                "permissions": { "editcatalogue": "edit_catalogue" }
            }
        }
    },
    "/entries/{entry_id}": {
        "put": {
            "x-mojo-to": "Com::ByWaterSolutions::FSRecordMetadata::Controller#update_entry",
            "operationId": "fsrmUpdateEntry",
            "tags": ["fsrecordmetadata"],
            "consumes": ["application/json"],
            "produces": ["application/json"],
            "parameters": [
                {
                    "name": "entry_id",
                    "in": "path",
                    "required": true,
                    "type": "integer"
                },
                {
                    "name": "body",
                    "in": "body",
                    "required": true,
                    "schema": {
                        "type": "object",
                        "properties": {},
                        "additionalProperties": false
                    }
                }
            ],
            "responses": {
                "200": { "description": "Entry updated", "schema": { "type": "object" } },
                "400": { "description": "Bad request", "schema": { "type": "object", "properties": { "error": { "type": "string" } } } },
                "404": { "description": "Entry not found", "schema": { "type": "object", "properties": { "error": { "type": "string" } } } },
                "500": { "description": "Internal server error", "schema": { "type": "object", "properties": { "error": { "type": "string" } } } }
            },
            "x-koha-authorization": {
                "permissions": { "editcatalogue": "edit_catalogue" }
            }
        }
    },
    "/lookup": {
        "get": {
            "x-mojo-to": "Com::ByWaterSolutions::FSRecordMetadata::Controller#lookup_record",
            "operationId": "fsrmLookupRecord",
            "tags": ["fsrecordmetadata"],
            "produces": ["application/json"],
            "parameters": [
                {
                    "name": "biblionumber",
                    "in": "query",
                    "required": false,
                    "type": "integer"
                },
